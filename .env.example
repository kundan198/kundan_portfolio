# Contact form (src/app/api/contact) — uses Resend. Without RESEND_API_KEY the
# form still validates but does not send mail.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
RESEND_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Game character chat (src/app/api/character, /api/models) — talks to an Ollama
# server. Defaults to http://127.0.0.1:11434, which does NOT exist on Vercel;
# point this at a publicly reachable Ollama host or leave the feature off.
OLLAMA_HOST=
OLLAMA_MODEL=
